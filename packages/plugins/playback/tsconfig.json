{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM, as the api's own tsconfig has it: AudioContext is a platform
    // type this plugin NAMES (ctx.audio.context(), Tone.setContext).
    // Naming the type is not touching the DOM — plugin-boundaries still
    // fails the build on a window/document/navigator global.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
