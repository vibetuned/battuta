---
/**
 * A real screenshot of the running editor (see scripts/build-shots.mjs).
 *
 * Shots are captured at 2× and displayed at their CSS size, so they stay
 * crisp on high-density screens. Alt text lives with the capture script
 * and travels in shots/manifest.json — one source of truth for what the
 * picture shows, exactly like the notation figures.
 */
import manifest from "../../public/shots/manifest.json";

interface Props {
  /** Shot name, without extension — e.g. "statusbar". */
  name: string;
  /** Caption under the screenshot. Omit for a bare illustration. */
  caption?: string;
  /** Override the natural display width (px). */
  width?: number;
}

const { name, caption, width } = Astro.props;
const entry = manifest.shots.find((s) => s.name === name);
if (!entry) throw new Error(`Shot "${name}" is not in shots/manifest.json — run: npm run shots`);
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/shots/${name}.png`;
const natural = width ?? entry.width;
---

<figure class="app-shot">
  <img
    src={src}
    alt={entry.alt}
    width={entry.width}
    height={entry.height}
    style={`width:min(100%, ${natural}px)`}
    loading="lazy"
  />
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .app-shot {
    margin: 1rem 0 1.5rem;
  }
  .app-shot img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.45rem;
    box-shadow: 0 1px 6px color-mix(in srgb, var(--sl-color-gray-1) 12%, transparent);
  }
  .app-shot figcaption {
    margin-top: 0.45rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }
</style>
