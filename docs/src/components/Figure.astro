---
/**
 * A notation figure engraved by Verovio (see scripts/build-figures.mjs).
 *
 * The SVG carries color="currentColor", so the ink follows Starlight's
 * light/dark text colour instead of being baked black. Alt text lives with
 * the figure definition and travels in figures/manifest.json — one source
 * of truth for what the picture shows.
 */
import manifest from "../../public/figures/manifest.json";

interface Props {
  /** Figure name, without extension — e.g. "articulations". */
  name: string;
  /** Caption under the figure. Omit for a bare illustration. */
  caption?: string;
  /** Override the natural display width (px) taken from the engraving. */
  width?: number;
}

const { name, caption, width } = Astro.props;
const entry = manifest.figures.find((f) => f.name === name);
if (!entry) throw new Error(`Figure "${name}" is not in figures/manifest.json — run: npm run figures`);
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/figures/${name}.svg`;
// Notation figures are wide and shallow: stretching a one-measure snippet to
// the full column blows the staff up, so each one renders at the size its own
// engraving asks for, capped by the column.
const natural = width ?? entry.width;
---

<figure class="notation-figure">
  {/* The frame owns the width so the hover hint can sit on the image's own
      corner rather than the column's. */}
  <span class="zoom-frame" style={natural ? `width:min(100%, ${natural}px)` : undefined}>
    <img src={src} alt={entry.alt} width={entry.width} height={entry.height} loading="lazy" tabindex="0" />
  </span>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .notation-figure {
    margin: 1rem 0 1.5rem;
  }
  .notation-figure .zoom-frame {
    display: block;
    position: relative;
    max-width: 100%;
  }
  .notation-figure img {
    display: block;
    width: 100%;
    height: auto;
    /* Notation is ink on paper: a light card under both themes, rather than
       grey-on-grey. The SVG's ink colour is fixed at build time. */
    background: #fcfcfa;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    padding: 0.5rem 0.7rem;
    box-sizing: border-box;
  }
  .notation-figure figcaption {
    margin-top: 0.45rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }
</style>
