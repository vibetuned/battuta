# LF in the repository and in the working tree on every platform.
#
# Without this, a Windows build rewrites tracked text files with CRLF and
# they surface as modified with no content change — Cargo.toml and
# gen/schemas/*.json both did exactly that during the first Windows run.
# The repo has no .bat/.cmd/.ps1, so nothing here needs CRLF.
* text=auto eol=lf

# Line-ending translation must never touch these. sample.mxl is a zip:
# a single rewritten byte makes it unreadable to Verovio. battuta.desktop
# and *.sh are read by Linux, where CRLF breaks them.
*.mxl   binary
*.mp3   binary
*.png   binary
*.ico   binary
*.icns  binary
*.sh          text eol=lf
*.desktop     text eol=lf
