<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The share sheet hands other apps a file from battuta's cache through
             this provider. Its own class, so it never collides with the app's
             FileProvider when the manifests merge. -->
        <provider
            android:name="com.vibetuned.battuta.mobile.BattutaShareProvider"
            android:authorities="${applicationId}.battuta.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/battuta_share_paths" />
        </provider>
    </application>
</manifest>
