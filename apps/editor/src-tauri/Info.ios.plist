<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist by the Tauri CLI. battuta's
     Documents folder — where its scores are saved on an iPad — shows in
     the Files app as "On My iPad › battuta", and opens in place there. -->
<plist version="1.0">
<dict>
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- Background audio (phase 10, M3): iPadOS lets an app create a virtual
       MIDI source — the "battuta" other apps hear playback from, as on the
       desktop — only with this mode (MIDISourceCreate is refused without
       it); it also keeps playback going when the iPad locks. -->
  <!-- Asked before Apple's Bluetooth MIDI view lists instruments (M3). -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>battuta connects to your Bluetooth MIDI instrument to hear what you play.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
</dict>
</plist>
