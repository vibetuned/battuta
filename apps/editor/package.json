{
  "name": "@battuta/editor",
  "version": "0.0.3",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build -w @battuta/core && npm run build -w @battuta/api",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "budget": "node scripts/check-budget.mjs",
    "keymap:snapshot": "UPDATE_KEYMAP_SNAPSHOT=1 vitest run test/keymap-snapshot.test.ts"
  },
  "dependencies": {
    "@battuta/api": "*",
    "@battuta/core": "*",
    "@battuta/plugin-lyrics": "*",
    "@battuta/plugin-onscreen-keyboard": "*",
    "@battuta/plugin-reflection": "*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tone": "^15.1.22",
    "verovio": "^6.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
